#!/usr/bin/env bash
# SmartCRM: bitta buyruq bilan o'rnatish (Ubuntu/Debian):
#   curl -fsSL https://apt.aigate.uz/install | sudo bash
# Manbani ulaydi, `smartcrm` paketini o'rnatadi va o'rnatuvchini ishga tushiradi (domen va boshqalarni so'raydi).
# Faqat paketni o'rnatish (o'rnatuvchisiz):  curl -fsSL https://apt.aigate.uz/install | sudo SMARTCRM_NO_INSTALL=1 bash
set -euo pipefail
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; C=$'\033[36m'; N=$'\033[0m'; else B=''; G=''; C=''; N=''; fi
[ "$(id -u)" -eq 0 ] || { echo "Root huquqi kerak: ... | sudo bash" >&2; exit 1; }
command -v apt-get >/dev/null 2>&1 || { echo "Bu skript faqat Ubuntu/Debian uchun (apt kerak)." >&2; exit 1; }

BASE="https://apt.aigate.uz"
printf '\n%s[1/2]%s %sSmartCRM paketi o'"'"'rnatilmoqda%s\n' "$C" "$N" "$B" "$N"
printf '  • Kalit: /usr/share/keyrings/smartcrm.gpg\n  • Manba: /etc/apt/sources.list.d/smartcrm.list (%s)\n' "$BASE"
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq >/dev/null 2>&1 || true
apt-get install -y -qq curl ca-certificates >/dev/null
curl -fsSL "$BASE/smartcrm.gpg" -o /usr/share/keyrings/smartcrm.gpg
echo "deb [signed-by=/usr/share/keyrings/smartcrm.gpg] $BASE stable main" > /etc/apt/sources.list.d/smartcrm.list
apt-get update -qq >/dev/null
apt-get install -y -qq smartcrm >/dev/null
printf '  %s✓%s paket o'"'"'rnatildi\n' "$G" "$N"

if [ "${SMARTCRM_NO_INSTALL:-}" = 1 ]; then
  printf '\n%s✓ Tayyor.%s Tizimni o'"'"'rnatish: %ssudo smartcrm install%s\n' "$G" "$N" "$B" "$N"
  exit 0
fi

printf '\n%s[2/2]%s %sTizim o'"'"'rnatilmoqda%s\n' "$C" "$N" "$B" "$N"
# stdin bu yerda quvur (curl | bash): savollar terminaldan o'qilishi uchun /dev/tty ga ulaymiz
if { : </dev/tty; } 2>/dev/null; then
  exec smartcrm install </dev/tty
fi
exec smartcrm install
